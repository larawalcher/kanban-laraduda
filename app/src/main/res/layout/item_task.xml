<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/constraintLayout1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        app:cardCornerRadius="15dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/constraintLayout2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <TextView
                android:id="@+id/textDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Criar layout da tela de login do app"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- Botões em cadeia horizontal -->
            <ImageButton
                android:id="@+id/buttonBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginTop="36dp"
                android:background="@android:color/transparent"
                android:contentDescription="Anterior"
                android:src="@drawable/ic_backblack"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/textDescription"
                app:tint="@color/color_default" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonDelete"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:text="Remover"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:background="@drawable/bg_btn"
                app:backgroundTint="@color/color_delete"
                app:layout_constraintTop_toBottomOf="@id/textDescription"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/buttonEditar"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonEditar"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:text="Editar"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:background="@drawable/bg_btn"
                app:backgroundTint="@color/color_default"
                app:layout_constraintTop_toBottomOf="@id/textDescription"
                app:layout_constraintStart_toEndOf="@id/buttonDelete"
                app:layout_constraintEnd_toStartOf="@id/buttonDetails"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonDetails"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:text="Detalhes"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:background="@drawable/bg_btn"
                app:backgroundTint="@color/color_datails"
                app:layout_constraintTop_toBottomOf="@id/textDescription"
                app:layout_constraintStart_toEndOf="@id/buttonEditar"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- Define o estilo da cadeia horizontal -->
            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guidelineHorizontalChain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintHorizontal_chainStyle="spread" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
